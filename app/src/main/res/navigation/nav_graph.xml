<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardFragment">

    <fragment
        android:id="@+id/onboardFragment"
        android:name="com.example.labs_app.ui.onboard.OnboardFragment"
        android:label="Onboard">
        <action
            android:id="@+id/action_onboard_to_signIn"
            app:destination="@id/signInFragment" />
    </fragment>

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.example.labs_app.ui.signin.SignInFragment"
        android:label="SignIn">
        <argument
            android:name="prefill"
            app:argType="com.example.labs_app.model.SignInPrefill"
            app:nullable="true" />
        <action
            android:id="@+id/action_signIn_to_signUp"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_signIn_to_home"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.labs_app.ui.signup.SignUpFragment"
        android:label="SignUp">
        <action
            android:id="@+id/action_signUp_to_signIn"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/signInFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.labs_app.ui.home.HomeFragment"
        android:label="Home">
        <argument
            android:name="user"
            app:argType="com.example.labs_app.model.User"
            app:nullable="true" />
        <action
            android:id="@+id/action_home_to_onboard"
            app:destination="@id/onboardFragment"
            app:popUpTo="@id/onboardFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
